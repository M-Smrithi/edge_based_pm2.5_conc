# Copy to .env (or export in your shell). Never commit real values.
# Session-signing key. If unset, a random key is generated once and stored in instance/secret.key (mode 0600).
SECRET_KEY=
# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
AIOT_SECURE_COOKIES=0
# Optional relocations
# AIOT_HOME=/path/to/data-root          # contains storage/ and instance/
# AIOT_DB=/path/to/app.db
# AIOT_STATIONS_INFO=/path/to/stations_info.csv
# Optional limits
# AIOT_MAX_UPLOAD_FILE_MB=64
# AIOT_MAX_JOBS=1
# AIOT_HOLDOUT_FRAC=0.15
# There are NO default credentials. Create the first administrator with:
#   AIOT_ADMIN_PASSWORD='choose-a-long-passphrase' python manage.py create-admin --email you@example.org --password-env AIOT_ADMIN_PASSWORD
